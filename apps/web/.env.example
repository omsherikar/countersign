# Browser base path for the api; next.config.ts rewrites /api/* to API_INTERNAL_URL.
NEXT_PUBLIC_API_BASE=/api
# Server-side api address (compose sets http://api:8000).
API_INTERNAL_URL=http://localhost:8000
# 1 serves contract fixtures from lib/mock so every page renders without the backend.
NEXT_PUBLIC_MOCK_API=0
