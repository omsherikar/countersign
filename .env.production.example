# Production settings for one public VM (README, "Deploy on one VM"). Copy to .env on the
# server and replace every value marked REPLACE. Never commit the filled-in copy.

# ---- Compose: every docker compose and make command uses the production overrides ----
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---- Public address (Caddy gets the HTTPS certificate for it) ----
DOMAIN=countersign.example.org
# The demo mailbox at https://DOMAIN/mailpit/: a user name and a bcrypt hash of its password,
# from `docker run --rm caddy:2.10-alpine caddy hash-password -p '<password>'`. Keep the
# single quotes: the hash contains $ signs.
MAILPIT_USER=demo
MAILPIT_PASSWORD_HASH='REPLACE'

# ---- Postgres (one instance, three databases) ----
POSTGRES_USER=countersign
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
API_DB_NAME=countersign
API_TEST_DB_NAME=countersign_test
MOCKGOV_DB_NAME=mockgov

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0

# ---- API ----
# generate: openssl rand -hex 32
API_SECRET_KEY=REPLACE
API_ACCESS_TOKEN_MINUTES=120
# HMAC key for APAAR / mobile / address lookups (hex, 32 bytes)
# generate: openssl rand -hex 32
PII_HMAC_KEY=REPLACE
# Fernet key for the encrypted APAAR copy (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# generate: openssl rand -base64 32 | tr '+/' '-_'
PII_FERNET_KEY=REPLACE
CORS_ORIGINS=https://countersign.example.org
WEB_BASE_URL=https://countersign.example.org

# ---- Government adapters: inmemory | mockgov | real ----
GOV_ADAPTER=mockgov
MOCKGOV_BASE_URL=http://mockgov:8001
# Real adapters stay disabled. Never set this to true in a demo.
ALLOW_REAL_GOV_APIS=false

# ---- mockgov chaos defaults ----
MOCKGOV_LATENCY_MS=0
MOCKGOV_FAIL_RATE=0

# ---- Upload pipeline ----
# Concurrent government source calls while checking one chunk of enrolments
CHECKS_CONCURRENCY=32
# Largest accepted upload file in bytes (20 MB)
UPLOAD_MAX_BYTES=20971520
# Most data rows accepted in one file
UPLOAD_MAX_ROWS=50000
# Most rows accepted in one POST /uploads/rows call
UPLOAD_ROWS_API_MAX=5000
# Where the api writes encrypted uploads for the worker (compose volume upload-spool)
UPLOAD_SPOOL_DIR=/data/spool
# true runs an upload in the api process after the response instead of on the worker (tests)
UPLOAD_INLINE=false

# ---- Mail (Mailpit) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=notices@countersign.demo
# SMTP hosts the mailer may connect to (comma-separated); anything else is refused
SMTP_ALLOWED_HOSTS=mailpit,localhost,127.0.0.1
# Lets the mailer use a host outside SMTP_ALLOWED_HOSTS. Never set this to true.
ALLOW_REAL_SMTP=false
# From address on student notices and document requests
NOTICE_FROM="Countersign <notices@countersign.invalid>"

# ---- Student notices, cases and credentials ----
# Public web address used in notice links, share links and QR codes
WEB_ORIGIN=https://countersign.example.org
# Credential issuer (`iss`); the JWKS is served at {ISSUER_URL}/.well-known/jwks.json
ISSUER_URL=https://countersign.example.org/api
# Where college responses to document requests are stored (compose volume case-files)
CASE_FILES_DIR=/data/case-files
# true enables demo-only tooling such as `make audit-tamper`; false outside the demo
DEMO_MODE=true

# ---- DigiLocker sign-in (the demo uses mockgov's labelled simulator) ----
# The api's client id and secret; mockgov reads the same two values and signs id tokens with
# the secret, so they must match on both sides
DIGILOCKER_CLIENT_ID=countersign-demo
# generate: openssl rand -hex 24
DIGILOCKER_CLIENT_SECRET=REPLACE
# The sign-in page the browser opens (Caddy serves it from mockgov)
DIGILOCKER_AUTHORIZE_URL=https://countersign.example.org/digilocker/oauth/authorize
# The `iss` the id token must carry; mockgov issues tokens with the same value
DIGILOCKER_ISSUER=https://countersign.example.org/digilocker

# ---- Private set intersection (D48) ----
# Countersign's PSI client (compose service psi-client); the api hands it the APAAR HMACs of
# linked students for one run and gets back three counts
PSI_CLIENT_URL=http://psi-client:8002
# How long one run may take, in seconds (about 10 under amd64 emulation for the small dataset)
PSI_TIMEOUT_SECONDS=120

# ---- Web ----
NEXT_PUBLIC_API_BASE=/api
API_INTERNAL_URL=http://api:8000

# ---- Cookies / versioning ----
COOKIE_SECURE=true
API_VERSION=0.1.0

# ---- API runtime knobs ----
# Path to rules.yaml inside the api container (compose mounts it at /app/rules.yaml)
RULES_PATH=./rules.yaml
# Run `alembic upgrade head` when the api starts
AUTO_MIGRATE=true
# Per-IP rate limits on public routes (tests switch this off)
RATE_LIMITS_ENABLED=true
LOG_LEVEL=INFO
# Academic year the dashboards and institution rows count by default
ACADEMIC_YEAR=2026-27
# Timeout for every call to a government source adapter, in seconds
GOV_TIMEOUT_SECONDS=3
# Sign-in attempts allowed per client IP ("10/minute", "100/hour"). Dev can raise it,
# e.g. 1000/minute, when repeated sign-ins start returning 429.
LOGIN_RATE_LIMIT=10/minute
